# Proposed exact-file API context. Every other current or future path is denied.
# Literal file exceptions retain traversal without admitting whole directories.
**
!Cargo.toml
!rust-toolchain.toml
!crates/shared-kernel/Cargo.toml
!crates/shared-kernel/src/lib.rs
!crates/aspects/Cargo.toml
!crates/aspects/src/lib.rs
!crates/audit-macro/Cargo.toml
!crates/audit-macro/src/lib.rs
!crates/axum-api/Cargo.toml
!crates/axum-api/src/lib.rs
!crates/axum-api/src/main.rs
!crates/axum-api/src/bin/migrate.rs
!crates/axum-api/src/bin/token.rs
!crates/axum-api/migrations/0001_course.sql
!crates/dop-bench/Cargo.toml
!crates/dop-bench/src/lib.rs
!crates/dop-bench/benches/layout.rs
!crates/event-svc/Cargo.toml
!crates/event-svc/src/lib.rs
!crates/event-svc/src/main.rs
!crates/desktop-core/Cargo.toml
!crates/desktop-core/src/lib.rs
!crates/extras-solutions/Cargo.toml
!crates/extras-solutions/src/lib.rs

# Defense in depth for later local use; no secret or runtime input is admitted.
**/.env
**/.env.*
**/.git
**/.git/**
**/.cargo
**/.cargo/**
**/.cache
**/.cache/**
**/target
**/target/**
**/results
**/results/**
**/learner-snapshot
**/learner-snapshot/**
**/stores
**/stores/**
**/data
**/data/**
**/mlruns
**/mlruns/**
**/node_modules
**/node_modules/**
**/__pycache__
**/__pycache__/**
**/*.db
**/*.sqlite*
**/*.log
**/*.pem
**/*.key

# Docker still receives its control files, but they are not image COPY inputs.
Dockerfile
.dockerignore
